# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/propulseiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=propulseiq

# Redis
REDIS_URL=redis://redis:6379/0

# AI Service (Choose one)
ANTHROPIC_API_KEY=sk-ant-xxxxx
# OPENAI_API_KEY=sk-xxxxx

# JWT Authentication
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Rate Limiting (requests per day)
API_RATE_LIMIT_FREE=100
API_RATE_LIMIT_PRO=5000
API_RATE_LIMIT_BUSINESS=50000

# AI Analysis Configuration
AI_MODEL=claude-3-5-sonnet-20241022
AI_MAX_RETRIES=3
AI_BATCH_SIZE=5
AI_DAILY_QUOTA=1000

# Content Retention (days)
RAW_CONTENT_RETENTION_DAYS=30
